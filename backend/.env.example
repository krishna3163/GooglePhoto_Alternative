# TeleGphoto Backend Environment Configuration
NODE_ENV=development
PORT=4000

# MongoDB Atlas Database URI (Free Tier M0 cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/telegphoto?retryWrites=true&w=majority

# JWT Secrets for Cross-Device Authentication
JWT_SECRET=your_jwt_access_token_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_key_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Frontend CORS Origin (Vercel Production & Localhost Dev)
FRONTEND_URL=https://telegphoto.vercel.app,http://localhost:5173

# Master Telegram Storage Credentials (Kept strictly on Render backend)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
